# ==============================================================================
# 全局部署控制配置文件 (可按需开启/关闭任意组件)
# ==============================================================================

# 基础环境
INSTALL_DOCKER="true"
ENABLE_FIREWALL="true"

# 核心服务开关
INSTALL_ASTRBOT="true"
INSTALL_NEWAPI="true"
INSTALL_GATEWAY="true"       # 是否安装 Python M3 动态可配置网关

# 证书与域名设置
ENABLE_SSL="true"            # true: 申请 Let's Encrypt 证书; false: 仅使用 HTTP
AUTO_NIP_DOMAIN="true"       # true: 自动分配 *.nip.io; false: 使用下方手动填写的域名
CUSTOM_BOT_DOMAIN=""
CUSTOM_API_DOMAIN=""
CUSTOM_GW_DOMAIN=""

# 端口映射配置 (避免与宿主机现有服务冲突)
PORT_ASTRBOT_INTERNAL="6185"
PORT_NEWAPI_INTERNAL="3000"
PORT_GATEWAY_WEB="8080"      # M3 网关面板与代理端口
PORT_HTTP="80"
PORT_HTTPS="443"

# 目录持久化路径
DIR_DATA_BASE="/opt/stack-deploy"
DIR_ASTRBOT="${DIR_DATA_BASE}/astrbot"
DIR_NEWAPI="${DIR_DATA_BASE}/new-api"
DIR_GATEWAY="${DIR_DATA_BASE}/gateway"
DIR_CERTS="/etc/ssl/stack-certs"

# 镜像版本
IMAGE_ASTRBOT="soulter/astrbot:latest"
IMAGE_NEWAPI="calciumion/new-api:latest"
